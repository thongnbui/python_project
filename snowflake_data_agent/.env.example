# OpenAI (drives the chat agent)
OPENAI_API_KEY="your_openai_api_key"
# Optional: override the default model (gpt-4o-mini)
# OPENAI_MODEL="gpt-4o-mini"
# Optional: model used for LLM-as-judge evals (defaults to gpt-4o)
# EVAL_JUDGE_MODEL="gpt-4o"

# Snowflake connection values are entered on the app's LOGIN PAGE.
# Any values below are only used to PRE-FILL the login form (convenience).
# The headless eval harness ALSO reads these to connect without the UI.
SNOWFLAKE_ACCOUNT="your_account_identifier"   # e.g. orgname-accountname
# SNOWFLAKE_USER="your_user"
SNOWFLAKE_WAREHOUSE="your_warehouse"          # e.g. COMPUTE_WH
SNOWFLAKE_DATABASE="your_database"            # e.g. SNOWFLAKE_SAMPLE_DATA
# SNOWFLAKE_SCHEMA="your_schema"              # blank = explore ALL schemas
SNOWFLAKE_ROLE="your_role"                    # e.g. ACCOUNTADMIN

# Key-pair authentication. Snowflake stores RSA_PUBLIC_KEY on the user; this app
# authenticates with the matching private key file.
# SNOWFLAKE_PRIVATE_KEY_FILE="/Users/you/.snowflake/rsa_key.p8"
# SNOWFLAKE_PRIVATE_KEY_PWD="optional_private_key_passphrase"

# Advanced (rarely needed): how the MCP server is launched
# SNOWFLAKE_MCP_COMMAND="uvx"
# SNOWFLAKE_MCP_PACKAGE="mcp_snowflake_server"

# Agent tunables (optional)
# MAX_AGENT_STEPS=18
# MAX_TOOL_RESULT_CHARS=10000
# MAX_CONTEXT_CHARS=120000
