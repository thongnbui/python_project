# OpenAI (drives the chat agent)
OPENAI_API_KEY="your_openai_api_key"
# Optional: override the default model (gpt-4o)
# OPENAI_MODEL="gpt-4o"

# Snowflake connection (used to launch the MCP server)
SNOWFLAKE_ACCOUNT="your_account_identifier"   # e.g. xy12345.us-east-1
SNOWFLAKE_USER="your_user"
SNOWFLAKE_PASSWORD="your_password"
SNOWFLAKE_WAREHOUSE="your_warehouse"          # e.g. COMPUTE_WH

# Required: the MCP server needs a default database to connect.
SNOWFLAKE_DATABASE="your_database"            # e.g. SNOWFLAKE_SAMPLE_DATA
# Optional: leave unset to explore ALL schemas in the database.
# (Defaults to INFORMATION_SCHEMA just to satisfy the connection.)
# SNOWFLAKE_SCHEMA="your_schema"              # e.g. TPCH_SF1

# Optional but recommended
SNOWFLAKE_ROLE="your_role"                    # e.g. ACCOUNTADMIN

# Advanced (rarely needed): how the MCP server is launched
# SNOWFLAKE_MCP_COMMAND="uvx"
# SNOWFLAKE_MCP_PACKAGE="mcp_snowflake_server"
